# Copy to frontend/.env and fill in. Never commit .env.
#
# Used by vite.config.ts for the dev-server proxy (/api -> backend).
# Vite reads this file for VITE_* variables, but the proxy target is read from
# process.env, so export it in your shell if you change it locally.
# Default when unset: http://localhost:8000.
VITE_API_TARGET=http://localhost:8000
