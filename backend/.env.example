# Copy to backend/.env and fill in. Never commit .env.
# Read by app/core/config.py (pydantic-settings). Paths below are relative to backend/.

APP_ENV=dev
# Dev-only: log full request/response bodies.
HTTP_BODY_LOG=false

# PostgreSQL (psycopg 3). Use the postgresql+psycopg:// scheme.
# Local Docker (docker compose up -d postgres):
DATABASE_URL=postgresql+psycopg://tytalk:tytalk@localhost:5432/tytalk
# On Vercel storage you can leave DATABASE_URL empty: POSTGRES_URL is used (and normalized).
# Set true on Vercel so the schema is created on cold start.
RUN_MIGRATIONS_ON_START=false
# Supabase: replace the scheme postgres:// with postgresql+psycopg:// and use your
# own password. Drop non-libpq query params such as "supa=..." from the URL.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

# Dev-only: exposes POST /auth/tester, a passwordless login for the shared tester account.
TESTER_LOGIN_ENABLED=false
TESTER_EMAIL=tester@tytalk.local

# LLM provider is configuration only. Any OpenAI-compatible endpoint works:
#   OpenRouter: https://openrouter.ai/api/v1       model e.g. openai/gpt-4o-mini
#   DeepSeek:   https://api.deepseek.com/v1        model e.g. deepseek-chat
#   Qwen:       https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:     https://api.openai.com/v1
# Set LLM_PROVIDER=anthropic (base URL https://api.anthropic.com/v1) for native Claude.
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=800

AUTH_RATE_LIMIT_PER_MINUTE=5
TALK_RATE_LIMIT_PER_MINUTE=10

# Local TTS (tiny-voca, ONNX, CPU). Missing model files disable TTS; text still streams.
TTS_ENABLED=true
TTS_MODEL_DIR=/app/models/tiny-voca

IMAGE_DOMAIN_ALLOWLIST=["upload.wikimedia.org","thumb.wikimedia.org"]

# RAG (grounded answers from the PDF corpus). Rebuild the index after changing the embed model.
RAG_ENABLED=true
RAG_SOURCES_DIR=data/rag/sources
RAG_INDEX_DIR=data/rag/index
# English-only project. Must match the index it was built with.
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Empty disables the reranker.
RAG_RERANK_MODEL=
RAG_CHUNK_CHARS=1400
RAG_CHUNK_OVERLAP_CHARS=200
RAG_CANDIDATES=20
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
